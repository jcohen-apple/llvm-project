# RUN: llc -mtriple=aarch64 -mcpu=apple-m1 -run-pass=early-ifcvt -o - %s | FileCheck %s

# CHECK-LABEL: name: cascade_selector_args
# CHECK:      bb.0:
# CHECK:        Bcc
# CHECK:      bb.1:

--- |
  define i32 @cascade_selector_args(i32 %a, i32 %b, i32 %c) {
    ret i32 0
  }
...
---
name:            cascade_selector_args
alignment:       4
tracksRegLiveness: true
liveins:
  - { reg: '$w0', virtual-reg: '%0' }
  - { reg: '$w1', virtual-reg: '%1' }
  - { reg: '$w2', virtual-reg: '%2' }
body:             |
  bb.0:
    successors: %bb.5(0x40000000), %bb.1(0x40000000)
    liveins: $w0, $w1, $w2

    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w1
    %2:gpr32 = COPY $w2
    %30:gpr32 = MADDWrrr %0, %1, $wzr
    %31:gpr32 = MADDWrrr %30, %2, $wzr
    %38:gpr32common = ADDWrr %31, %0
    %40:gpr32 = MOVi32imm 42
    %41:gpr32 = SUBSWri %38, 1, 0, implicit-def $nzcv
    Bcc 12, %bb.5, implicit $nzcv
    B %bb.1

  bb.1:
    successors: %bb.5(0x40000000), %bb.2(0x40000000)

    %42:gpr32 = MOVi32imm 43
    %43:gpr32 = SUBSWri %38, 2, 0, implicit-def $nzcv
    Bcc 12, %bb.5, implicit $nzcv
    B %bb.2

  bb.2:
    successors: %bb.5(0x40000000), %bb.3(0x40000000)

    %44:gpr32 = MOVi32imm 44
    %45:gpr32 = SUBSWri %38, 3, 0, implicit-def $nzcv
    Bcc 12, %bb.5, implicit $nzcv
    B %bb.3

  bb.3:
    successors: %bb.5(0x40000000), %bb.4(0x40000000)

    %46:gpr32 = MOVi32imm 45
    %47:gpr32 = SUBSWri %38, 4, 0, implicit-def $nzcv
    Bcc 12, %bb.5, implicit $nzcv
    B %bb.4

  bb.4:
    successors: %bb.5(0x80000000)

    %48:gpr32 = SUBSWri %38, 5, 0, implicit-def $nzcv
    %49:gpr32 = CSINCWr $wzr, $wzr, 13, implicit $nzcv

  bb.5:
    %100:gpr32 = PHI %40, %bb.0, %42, %bb.1, %44, %bb.2, %46, %bb.3, %49, %bb.4
    $w0 = COPY %100
    RET_ReallyLR implicit $w0
...
